# Read-only source credentials. Keep real values outside the repository.
TWITTERAPIIO_API_KEY=
TINYFISH_API_KEY=

# Optional JSON arrays override announcement searches without changing code.
# X_QUERIES_JSON=["(\"accepted into YC\" OR \"joining YC\") -filter:retweets lang:en"]
# LINKEDIN_QUERIES_JSON=["site:linkedin.com/posts \"accepted into Y Combinator\""]

# Slack OAuth bot credentials. Delivery remains disabled until explicitly enabled.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_DELIVERY_ENABLED=false

# First live run normally creates a baseline and sends nothing to avoid a notification flood.
BOOTSTRAP_NOTIFY=false
NOTIFY_NEEDS_REVIEW=false
MONITOR_INTERVAL_SECONDS=28800
MONITOR_DATABASE_PATH=data/monitor.db
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
